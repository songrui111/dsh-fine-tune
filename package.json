{
  "name": "dsh-fine-tune",
  "version": "0.7.0",
  "description": "Local LoRA / QLoRA fine-tuning for DeepSeek Harness: import JSONL, train on your own GPU (or a remote SSH host), evaluate, and export an adapter. One-click environment install; Windows + NVIDIA verified. 本地微调插件：数据集→训练→评测，支持本机与远程 GPU。",
  "type": "module",
  "main": "index.js",
  "author": "songrui",
  "exports": {
    ".": "./index.js",
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "lib/backend.mjs",
    "lib/bootstrap.mjs",
    "lib/dataset.mjs",
    "lib/evaluate.mjs",
    "lib/hardware.mjs",
    "lib/install.mjs",
    "lib/jobs.mjs",
    "lib/pack.mjs",
    "lib/redact.mjs",
    "lib/session.mjs",
    "lib/sources.mjs",
    "lib/ssh.mjs",
    "lib/textmetric.mjs",
    "lib/tools.mjs",
    "lib/training.mjs",
    "lib/transfer.mjs",
    "client/client.js",
    "sample/sample.jsonl",
    "python/fnt_worker/__init__.py",
    "python/fnt_worker/__main__.py",
    "python/fnt_worker/calibrate.py",
    "python/fnt_worker/textmetric.py",
    "python/tests/test_textmetric.py",
    "python/tests/test_worker.py"
  ],
  "engines": {
    "dsh": ">=0.1.7-rc.2"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": ">=3.18.0"
  },
  "scripts": {
    "test": "node test/unit.mjs && node test/host.mjs && node test/client.mjs",
    "test:unit": "node test/unit.mjs",
    "test:py": "python -m unittest discover -s python/tests",
    "test:ssh": "node test/ssh-e2e.mjs",
    "test:ssh-train": "node test/ssh-train-e2e.mjs",
    "sync": "node scripts/sync.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "fine-tune",
    "lora",
    "qlora",
    "sft",
    "training",
    "ollama",
    "agent"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "engines": {
      "dsh": ">=0.1.7-rc.2"
    },
    "client": {
      "platform": "web"
    }
  }
}
