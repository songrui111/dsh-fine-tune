# ---- dependencies -----------------------------------------------------------
node_modules/
python/.venv/
.venv/

# ---- Python artefacts --------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/

# pip leaves these behind when an install is interrupted; they are multi-hundred
# MB and must never reach the repository (one run left 1.16 GB inside python/).
pip-unpack-*/
pip-install-*/
pip-build-tracker-*/
pip-ephem-wheel-cache-*/
pip-metadata-*/

# ---- local runtime data ------------------------------------------------------
# A plugin installed from a sibling directory writes its runs here; this is
# machine state, not source.
.dsh-fine-tune/
runs/
outputs/
datasets/
*.tgz

# ---- editors / OS ------------------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db

# ---- local experiments -------------------------------------------------------
# Scratch space used while validating the worker; not part of the package.
.tmp-*/
*.log
stderr.log
.test-keys/

# ---- SSH test keys -----------------------------------------------------------
# Generated by test/ssh-server.py. A private key must never reach a public
# repository, even a throwaway one: scanners flag it and it accustoms everyone to
# leaking them. The current location is .test-keys/; the bare names are what an
# earlier run left in the repo root.
.test-keys/
dsh-test-*-key
dsh-test-*-key.pub

# Local backups made while testing; never part of the package.
*.bak
*.bak-*
